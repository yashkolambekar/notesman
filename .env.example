# Embeddings: Google AI Studio (Gemini API). Get a key at https://aistudio.google.com/apikey
# Only used by scripts/ and e2e tests. The API and worker use each admin's own key.
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-2
# Matryoshka output size: 3072 (full), 1536, or 768. Changing it later means re-embedding everything.
EMBED_DIM=1536

# Chat answers: OpenRouter
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-sonnet-5.5

# Qdrant (docker compose up -d qdrant)
# https URL with no port uses 443; http with no port uses 6333; an explicit :port always wins
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=notesman_chunks

# Google sign-in (OAuth client from Google Cloud Console)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Remote Postgres. Must use the asyncpg driver. Add ?ssl=require if the server needs TLS.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Admins bring their own Gemini/OpenRouter keys (Settings > API keys). They are stored encrypted with this
# master key. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes every stored key unreadable (admins just re-enter them).
API_KEY_ENCRYPTION_KEY=

# Spend tracking (USD per million tokens). OpenRouter reports real chat cost; these are the fallback for chat
# and the only source for Gemini embeddings (tokens estimated from text length). Set them to your real prices.
EMBED_PRICE_PER_MTOK_USD=0.15
CHAT_PRICE_IN_PER_MTOK_USD=3.0
CHAT_PRICE_OUT_PER_MTOK_USD=15.0

# Auth
# Long random string that signs the session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Public origin of the web app. Google redirects back to PUBLIC_BASE_URL/api/v1/auth/google/callback
PUBLIC_BASE_URL=http://localhost:3000
# Google account email that becomes superadmin on sign-in
SUPERADMIN_EMAIL=

# Cloudflare R2 (S3 API token with read/write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Ingestion: texts per embedding request. Lower it if Google keeps rate limiting you.
EMBED_BATCH_SIZE=16

# Answer generation
# Empty = same as CHAT_MODEL
FAST_MODEL=
# Verify each draft against its sources and repair unsupported claims (1 extra cheap call + 1 repair if needed)
GROUNDING_CHECK=true

# Marks assumed when a question does not say (e.g. "(10 marks)"). 5 marks ~ one page, ~450 words.
DEFAULT_MARKS=5
